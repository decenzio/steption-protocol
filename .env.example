# Preview is local sample data. Set testnet only after manual contract deployment.
NEXT_PUBLIC_APP_MODE=preview
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_OPTIONS_CONTRACT_ID=
# SEO: set before building. Preview/local dev is automatically noindex.
SITE_URL=https://steptionprotocol.com
# Set false on a staging host to disable indexing in production builds.
SEO_INDEXING=true
# Optional ownership verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Optional newsletter integration; credentials are SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
